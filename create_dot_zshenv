# vim: ft=zsh:
# ~/.zshenv is read by every zsh process, including non-interactive shells.
# Keep it limited to exported variables and lightweight PATH setup.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export ZSHCONF_HOME="$HOME/.zshrc.d"
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export SUDO_EDITOR="${SUDO_EDITOR:-vim}"
export VIRTUAL_ENV_DISABLE_PROMPT=1
export FUNCNEST=100
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# Linuxbrew binaries link against linuxbrew glibc. Its default localedir is
# opt/glibc/lib/locale; generate a locale-archive there with localedef so
# setlocale() works (LOCPATH here would break system glibc's archive lookup).

# Keep shell-independent user tools available to login and non-login shells.
typeset -U path
path=("$HOME/.local/bin" "$HOME/.local/scripts" /usr/local/bin $path)
[[ -d /opt/homebrew/bin ]] && path=(/opt/homebrew/bin $path)
[[ -d /home/linuxbrew/.linuxbrew/bin ]] && path=(/home/linuxbrew/.linuxbrew/bin $path)

# WSL appends the entire Windows %PATH% (converted to /mnt/... paths). Every
# such entry costs a slow 9p stat on command lookups, so drop them all.
path=(${path:#/mnt/*})
export PATH

# Use the chezmoi-managed ~/.config/starship.toml by default.
export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$XDG_CONFIG_HOME/starship.toml}"

# Keep the historical location used by the previous configuration.
export HISTFILE="$ZSHCONF_HOME/.histfile"

# This create_ file is generated once by chezmoi and then belongs to the
# machine owner. Put host-specific variables, tokens, and paths here.

# Machine-specific defaults migrated from the former env.zsh.
export AI_COMMIT_CMD='claude-internal -p "$1"'
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
export NVIM_APPNAME="nvim.mini"
