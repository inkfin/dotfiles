#!/usr/bin/env python3
"""Read the Codex subscription's weekly quota for a status line."""

import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import threading
import time


CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "codex-weekly-quota" / "quota.json"
WEEK_MINUTES = 7 * 24 * 60
REFRESH_SECONDS = 300
RETRY_SECONDS = 60
MAX_STALE_SECONDS = 1800


def read_cache():
    try:
        return json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return {}


def refresh_due(cache, now):
    attempted_at = cache.get("attempted_at", 0)
    if cache.get("updated_at") != attempted_at or cache.get("resets_at", 0) <= now:
        return now - attempted_at >= RETRY_SECONDS
    return now - attempted_at >= REFRESH_SECONDS


def query_weekly_quota(codex):
    with subprocess.Popen(
        [codex, "app-server", "--stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        cwd=Path.home(),
    ) as app:
        deadline = threading.Timer(5, app.kill)
        deadline.start()

        def send(message):
            app.stdin.write(json.dumps(message) + "\n")
            app.stdin.flush()

        def receive(request_id):
            for line in app.stdout:
                message = json.loads(line)
                if message.get("id") == request_id:
                    return message["result"]
            raise ValueError("Codex app-server closed before responding")

        try:
            send({"id": 1, "method": "initialize", "params": {
                "clientInfo": {"name": "weekly-quota-statusline", "version": "1.0"},
            }})
            receive(1)
            send({"method": "initialized"})
            send({"id": 2, "method": "account/rateLimits/read"})
            limits = receive(2)["rateLimits"]
            for key in ("primary", "secondary"):
                window = limits.get(key) or {}
                if window.get("windowDurationMins") == WEEK_MINUTES:
                    remaining = min(100, max(0, int(100 - window["usedPercent"])))
                    return remaining, int(window["resetsAt"])
        finally:
            deadline.cancel()
            app.kill()


def refresh(codex):
    CACHE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with CACHE.with_suffix(".lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        cache = read_cache()
        now = time.time()
        if not refresh_due(cache, now):
            return
        cache["attempted_at"] = now
        try:
            quota = query_weekly_quota(codex)
        except (OSError, ValueError, KeyError, TypeError):
            pass
        else:
            if quota is None:
                cache = {"attempted_at": now}
            else:
                cache.update(remaining=quota[0], resets_at=quota[1], updated_at=now)
        pending = CACHE.with_suffix(".tmp")
        pending.write_text(json.dumps(cache))
        pending.replace(CACHE)


def status():
    codex = shutil.which("codex")
    if not codex:
        return ""
    cache = read_cache()
    now = time.time()
    if refresh_due(cache, now):
        subprocess.Popen(
            [sys.executable, "-I", str(Path(__file__).resolve()), "--refresh", codex],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    if now < cache.get("resets_at", 0) and now - cache.get("updated_at", 0) < MAX_STALE_SECONDS:
        return f"Codex 7d left {cache['remaining']}%"
    return ""


if __name__ == "__main__" and sys.argv[1:2] == ["--refresh"]:
    refresh(sys.argv[2])
