## .tmux.conf
## Commentary:
##
## inkfin's tmux config
##
## Code:

{{ $tv := output "tmux" "-V" | replace "tmux " "" | replace "next" "999.9" | trim -}}
{{- $major := int (regexReplaceAll "^([0-9]+).*" $tv "${1}") -}}
{{- $minor := int (regexReplaceAll "^[0-9]+\\.([0-9]+).*" $tv "${1}") -}}
{{- $ver := add (mul $major 100) $minor -}}
## version gates: >=301 menu, >=302 copy-command/terminal-features/extended-keys/popup,
## >=303 allow-passthrough, >=305 extended-keys-format

## basic settings
set-option -g focus-events on
set -g set-clipboard on

# native clipboard integration (replaces tmux-yank) (3.2+)
{{ if ge $ver 302 }}
{{ if eq .chezmoi.os "darwin" }}
set -g copy-command 'pbcopy'
{{ else if eq .chezmoi.os "linux" }}
set -g copy-command 'xclip -selection clipboard'
{{ else if eq .chezmoi.os "windows" }}
set -g copy-command 'clip.exe'
{{ end }}
{{ end }}

set-option -g prefix C-g
unbind C-b
bind C-a send-prefix # bind C-a as new tmux prefix
set-option -g prefix2 C-`

#bind-key -n C-b send-prefix

set-option -g mouse on # mouse on
setw -g mode-keys vi

set -g status on
set -g status-justify centre
set -g status-interval 10
set-option -g status-position bottom
setw -g monitor-activity on # 非当前窗口有内容更新时在状态栏通知

# start numbering at 1 and renumber windows to fill gaps
set -g base-index 1
set -g pane-base-index 1
set -g renumber-windows on
# let programs (nvim etc.) rename windows
set -g allow-rename on

# pane borders only when the window has multiple panes (hook keeps it in sync)
set -g pane-border-status off
set -g pane-border-format '#{pane_index} #{pane_current_command}'
set-hook -g window-layout-changed 'if-shell "test #{window_panes} -gt 1" "set -w pane-border-status top" "set -w pane-border-status off"'

# use tmux instead of screen to enable italics and fzf support
# NOTE: tmux-direct breaks zsh (autosuggestions/syntax-highlighting render
# duplicated characters). Truecolor still works: tmux sets COLORTERM=truecolor
# for every pane (nvim picks it up) and ',*:RGB' gives the status bar truecolor.
set -g default-terminal "tmux-256color"
# advertise truecolor support to tmux's status line and pane borders (3.2+)
{{ if ge $ver 302 }}
set -ag terminal-features ',*:RGB'
{{ end }}
# make sure terminal passes cursor style (Ss, Se means set/reset cursor style)
set -as terminal-overrides ',*:Ss=\E[%p1%d q:Se=\E[2 q'
{{ if eq .chezmoi.os "darwin" }}
# add italic support on iTerm2 (https://weibeld.net/terminals-and-shells/italics.html)
set -as terminal-overrides ',xterm*:sitm=\E[3m'
{{ end }}
set-window-option -g xterm-keys on # tell tmux to send xterm keys
# Enable modified key reporting (for keys like Ctrl/Alt+Enter)
{{ if ge $ver 302 }}
set -g extended-keys on
{{ end }}
{{ if ge $ver 305 }}
set -g extended-keys-format csi-u
{{ end }}
# Default to zsh (some platform can't recognize default shell)
set-option -g default-shell /bin/zsh

# Address vim mode switching delay (http://superuser.com/a/252717/65504)
set -sg escape-time 10
# Increase scrollback buffer size from 2000 to 50000 lines
set -g history-limit 50000
# Increase tmux messages display duration from 750ms to 4s
set -g display-time 4000
# Persist command history for the tmux prompt (prefix + :) across restarts (3.5+)
set -g history-file ~/.tmux/history
# Keep more message/copy-mode history lines in the scrollback
set -g message-limit 10000
# Emacs key bindings in tmux command prompt (prefix + :)
set -g status-keys emacs
# Super useful when using "grouped sessions" and multi-monitor setup
setw -g aggressive-resize on

## image preview
{{ if ge $ver 303 }}
set -g allow-passthrough on
{{ end }}
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM
set -g visual-activity off

# sixel image passthrough (iTerm2 3.5+, tmux 3.3+). (3.2+)
# Scoped to iTerm2's TERM only, so a future kitty terminal (TERM=xterm-kitty)
# won't be told it supports sixel.
{{ if ge $ver 302 }}
set -as terminal-features 'xterm-256color*:sixel'
set -as terminal-features 'tmux*:sixel'
set -as terminal-features 'screen*:sixel'
{{ end }}

## key-mappings
bind -N "New window" c new-window -c "#{pane_current_path}"
bind -N "Split window" '"' split-window -c "#{pane_current_path}"
bind -N "Split horizontal" % split-window -h -c "#{pane_current_path}"
bind -N "Split vertical" - splitw -v -c '#{pane_current_path}'
bind -N "Split horizontal" \| splitw -h -c '#{pane_current_path}'

bind -r -N "Pane up" k select-pane -U
bind -r -N "Pane down" j select-pane -D
bind -r -N "Pane left" h select-pane -L
bind -r -N "Pane right" l select-pane -R

# resize panes with arrow keys, 5 cells per press (repeatable)
bind -r Up resizep -U 5
bind -r Down resizep -D 5
bind -r Left resizep -L 5
bind -r Right resizep -R 5
# slow resize with shift+arrow, 1 cell per press (repeatable)
bind -r S-Up resizep -U 1
bind -r S-Down resizep -D 1
bind -r S-Left resizep -L 1
bind -r S-Right resizep -R 1
# free ctrl+hjkl and built-in ctrl+arrow (resize 1): herdr uses ctrl+hjkl / ctrl+arrow
unbind C-k
unbind C-j
unbind C-h
unbind C-l
unbind C-Up
unbind C-Down

# ctrl+arrow: swap pane left/right (native swap-pane prev/next)
bind -N "Swap pane up" C-Left  swapp -U
bind -N "Swap pane down" C-Right swapp -D
# ctrl+up/down: rotate panes forward / reverse (pane order, not strict geometry)
bind -N "Rotate window" C-Up    rotate-window
bind -N "Rotate window reverse" C-Down  rotate-window -D
# ctrl+p/n: previous/next session (aligns with herdr workspace switching)
bind -N "Previous session" C-p switch-client -p
bind -N "Next session" C-n switch-client -n

# swap the current window left / right in the tab order.
bind -r -N "Swap window left" < swap-window -d -t :-
bind -r -N "Swap window right" > swap-window -d -t :+

# fuzzy window/session switcher
bind -N "Choose window" w choose-tree -Zw
# popup menu with common actions (display-menu 3.0+, bind -N 3.1+)
{{ if ge $ver 301 }}
bind -N "Show tmux menu" m display-menu -T "⟪ Tmux Menu ⟫" \
    "New Window"           c  "new-window -c '#{pane_current_path}'" \
    "Split Horizontal"     %  "split-window -h -c '#{pane_current_path}'" \
    "Split Vertical"       '"' "split-window -c '#{pane_current_path}'" \
    "Zoom Pane"            z  "resize-pane -Z" \
    "--" "--" "--" \
    "Rename Window"        ,  "command-prompt -I '#W' 'rename-window %%'" \
    "Kill Pane"            x  "kill-pane" \
    "Kill Window"          &  "confirm-before kill-window" \
    "--" "--" "--" \
    "Copy Mode"            [  "copy-mode" \
    "Paste Buffer"         ]  "paste-buffer" \
    "Choose Window"        w  "choose-tree -Zw" \
    "--" "--" "--" \
    "Resurrect Save"       C-s "run-shell '~/.tmux/plugins/tmux-resurrect/scripts/save.sh'" \
    "Resurrect Restore"    C-r "run-shell '~/.tmux/plugins/tmux-resurrect/scripts/restore.sh'" \
    "Reload Config"        R  "source-file ~/.tmux.conf; display-message 'config reloaded'"
{{ end }}
# popup scratchpad terminal (3.2+). -E: 关闭 = exit 或 C-d（shell 退出时自动关）。
# 注意：popup 是模态 overlay，内部所有按键（含 prefix C-g）都直接进 shell——
# 这是 3.7 的设计限制，tmux 3.8 的 floating panes 才像普通 pane 一样可操作。
{{ if ge $ver 302 }}
bind -N "Open popup shell" M display-popup -E -h 60% -w 60% "zsh"
{{ end }}

## copy mode
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel

# Easy config reload
bind-key -N "Reload config" R source-file ~/.tmux.conf \; display-message "tmux.conf reloaded"
# save log
bind -N "Toggle pane logging" P pipe-pane -o "cat >>~/Desktop/#W.log" \; display "Toggled logging to ~/Desktop/#W.log"


### ==== Plugins ====
# List of plugins
set -g @plugin 'tmux-plugins/tpm'

# Other examples:
# set -g @plugin 'github_username/plugin_name'
# set -g @plugin 'github_username/plugin_name#branch'
# set -g @plugin 'git@github.com:user/plugin'
# set -g @plugin 'git@bitbucket.com:user/plugin'


## Status Bar

# https://draculatheme.com/tmux
set -g @plugin 'dracula/tmux'
set -g @plugin 'tmux-plugins/tmux-sensible'

# 显示prefix键有没有被按下
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'
# if have powerline font support
set -g @dracula-show-powerline true

# available plugins: battery, cpu-usage, git, gpu-usage, ram-usage, network, network-bandwidth, network-ping, weather, time
set -g @dracula-plugins "network-bandwidth ram-usage cpu-usage time" # "weather"
set -g @dracula-show-flags true
set -g @dracula-refresh-rate 10
set -g @dracula-ping-server "bing.com"
set -g @dracula-ping-rate 10
set -g @dracula-show-left-icon smiley
set -g @dracula-left-icon-padding 1
set -g @dracula-border-contrast true
set -g @dracula-show-timezone true
set -g @dracula-show-fahrenheit false
set -g @dracula-fixed-location "Shenzhen"
set -g @dracula-continuum-mode countdown
# Show if the last save was performed less than 60 seconds ago (default threshold is 15 seconds)
set -g @dracula-continuum-time-threshold 60
# available colors: white, gray, dark_gray, light_purple, dark_purple, cyan, green, orange, red, pink, yellow
set -g @dracula-cpu-usage-colors "light_purple dark_gray"
set -g @dracula-ram-usage-colors "cyan dark_gray"
set -g @dracula-git-colors "green dark_gray"
set -g @dracula-network-bandwidth-colors "orange dark_gray"
set -g @dracula-weather-colors "orange dark_gray"


# === tmux-resurrect
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
# 修改会话数据的保持路径，此处不能使用除了$HOME, $HOSTNAME, ~之外的环境变量
set -g @resurrect-dir '~/.tmux/resurrect/'
# 1. [默认]每隔15分钟自动保存，当然你可以连按两次<prefix>键手动保存
# 2. [需要设置]通电后自动打开tmux
#set -g @continuum-boot 'on'
# 3. 开启tmux后自动恢复上一个保存的环境
set -g @continuum-restore 'on'
# 4.保存终端里的内容
set -g @resurrect-capture-pane-contents 'on'
# 5.for vim
set -g @resurrect-strategy-vim 'session'
# 6.for neovim
set -g @resurrect-strategy-nvim 'session'





# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run -b '~/.tmux/plugins/tpm/tpm'


