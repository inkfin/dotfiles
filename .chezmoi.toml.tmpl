# vi: ft=toml

{{- /* Profiles: personal | work | server-personal | server-work
     Compose: hasSuffix "personal"|"work" . / hasPrefix "server" .
     Sprig: hasSuffix SUFFIX STRING / hasPrefix PREFIX STRING — see AGENTS.md
*/ -}}
{{- $profiles   := list "personal" "work" "server-personal" "server-work" }}

{{- $profile    := promptChoiceOnce . "data.profile" "Which profile should we apply" $profiles }}
{{- $name       := promptStringOnce . "data.name" "What's your name" "inkfin" }}
{{- $email      := promptStringOnce . "data.email" "What's your email" "inkfinite@qq.com" }}

{{- /* Encryption: only machines with ~/.config/chezmoi/age.key get the [age] block */}}
{{- $ageKey := joinPath .chezmoi.homeDir ".config/chezmoi/age.key" }}
{{- $hasAge := stat $ageKey }}
{{- if $hasAge }}
encryption = "age"
{{- end }}

[data]
    profile = {{ $profile | quote }}
    name = {{ $name | quote }}
    fullname = "Ink Zhang"
    email = {{ $email | quote }}
{{- if not (hasPrefix "server" $profile) }}
# Override per machine in ~/.config/chezmoi/chezmoi.toml [data.font].
[data.font]
{{- if eq .chezmoi.os "windows" }}
    term_font = "IosevkaTerm NFM Medium"
    editor_font = "Sarasa Term SC Nerd Font"
    ui_font = "ZedMono Nerd Font Mono"
{{- else }}
    term_font = "FantasqueSansM Nerd Font Mono"
    editor_font = "FantasqueSansM Nerd Font Mono"
    ui_font = "FiraCode Nerd Font Mono"
{{- end }}
    cjk_font = "Sarasa Term SC Nerd Font"
{{- end }}
{{- if $hasAge }}
[age]
    identity = {{ $ageKey | quote }}
    recipient = {{ dig "external" "encryption_recipient" "" . | quote }}
{{- end }}
[git]
    autoCommit = false
    autoPush = false
[merge]
    command = "nvim"
    args = ["-d", {{`"{{ .Destination }}"`}}, {{`"{{ .Source }}"`}}]
{{- if eq .chezmoi.os "windows" }}
[cd]
    command = "pwsh.EXE"
    args = ["-NoLogo"]
{{- end }}
