# git
# abbreviations (gst, lg, lzd, zj, cmc, cmcp, cmb) defined in config.nu

$env.SUDO_EDITOR = "vim"

{{ if eq .chezmoi.os "darwin" -}}
alias o = ^open
{{- end }}

# C++ environment
## cmake config
def cmcv [...args] {
    let toolchain_file = ($env.VCPKG_ROOT | path join "scripts/buildsystems/vcpkg.cmake" | path expand)
    cmake -S . -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_TOOLCHAIN_FILE=$toolchain_file -B ...$args
}

## toolset - reset to system defaults
$env.CC = ""
$env.CXX = ""

def cc_types [] {[
    "gcc",
    "clang",
{{- if eq .chezmoi.os "windows" }}
    "clang-llvm",
{{- end }}
    "empty",
]}

def set_cc --env [cc: string@cc_types, silent?: bool = true] {
    match $cc {
        "gcc" => {
{{- if eq .chezmoi.os "windows" }}
            $env.CC = ("~/scoop/apps/mingw/current/bin/gcc.EXE" | path expand)
            $env.CXX = ("~/scoop/apps/mingw/current/bin/g++.EXE" | path expand)
{{- else }}
            $env.CC = "gcc"
            $env.CXX = "g++"
{{- end }}
        }
        "clang" => {
{{- if eq .chezmoi.os "windows" }}
            $env.CC = ("~/scoop/apps/llvm/current/bin/clang.EXE" | path expand)
            $env.CXX = ("~/scoop/apps/llvm/current/bin/clang++.EXE" | path expand)
{{- else }}
            $env.CC = "clang"
            $env.CXX = "clang++"
{{- end }}
        }
{{- if eq .chezmoi.os "windows" }}
        "clang-llvm" => {
            $env.CC = ("C:/Program Files/LLVM/bin/clang.exe" | path expand)
            $env.CXX = ("C:/Program Files/LLVM/bin/clang++.exe" | path expand)
        }
{{- end }}
        _ => {
            $env.CC = ""
            $env.CXX = ""
        }
    }
    if not $silent {
        print $"CC=($env.CC) CXX=($env.CXX)"
    }
}

set_cc empty

## vcpkg
{{ if eq .chezmoi.os "windows" -}}
if not ("VCPKG_ROOT" in $env) {
    $env.VCPKG_ROOT = ("~/dev/vcpkg" | path expand)
}
safe_prepend_path $env.VCPKG_ROOT
{{- else -}}
$env.VCPKG_ROOT = ("~/dev/vcpkg" | path expand)
safe_prepend_path $env.VCPKG_ROOT
{{- end }}

# CUDA environment
{{ if eq .chezmoi.os "windows" -}}
$env.CUDA_PATH_V12_1 = ("C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.1" | path expand)
$env.CUDA_PATH_V11_2 = ("C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v11.2" | path expand)
$env.CUDA_PATH = $env.CUDA_PATH_V12_1
safe_prepend_path ($env.CUDA_PATH | path join "bin")
safe_prepend_path ($env.CUDA_PATH | path join "libnvvp")
{{- end }}

# bun
safe_prepend_path "~/.bun/bin"

