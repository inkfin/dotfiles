{
  "zoom": {{ if eq .chezmoi.os "windows" }}1.2{{ else }}1{{ end }},
  "sounds": {
    "enabled": true
  },
  "font_ligatures": false,
  "terminal_line_height": 1,
  "terminal_cell_width": 1,
  "terminal_scroll_speed": 1,
  "minimum_contrast": 1,
  "appearance": "dark",
  "font": {{ .font.term_font | toJson }}{{ if eq .chezmoi.os "darwin" }},
  "theme": "atom-one-dark",
  "worktrees": {
    "directory": "~/.agents/worktrees"
  },
  "font_size": 15,
  "font_weight": 500,
  "option_as_alt": "left"{{ end }}
}
