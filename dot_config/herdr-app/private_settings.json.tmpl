{
  "zoom": 1,
  "sounds": {
    "enabled": true
  },
  "font_ligatures": false,
  "terminal_line_height": 1,
  "terminal_cell_width": 1,
  "terminal_scroll_speed": 1,
  "minimum_contrast": 1,
  "theme": "atom-one-dark",
  "appearance": "dark",
  "worktrees": {
    "directory": "~/.agents/worktrees"
  },
  "font": {{ ((get .font "herdr_term_font") | default .font.term_font) | toJson }},
  "font_size": 15,
  "font_weight": 500,
  "option_as_alt": "left"
}
