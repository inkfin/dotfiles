// vim: ft=jsonc:
{
  "$schema": "https://opencode.ai/tui.json",
  // system 主题：text/background 用 none，不绘制不透明背景 → 透出终端透明
  "theme": "system",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": false,
    "volume": 0.4
  },
}
