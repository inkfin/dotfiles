# htoprc - server monitoring config
# This file is rewritten by htop when settings are changed.
fields=PERCENT_CPU,PERCENT_MEM,PERCENT_SWAP,USER,PID,NICE,M_RESIDENT,COMMAND
sort_key=PERCENT_MEM
tree_view=1
tree_view_always_by_pid=0
hide_kernel_threads=1
hide_userland_threads=1
hide_running_in_docker=0
shadow_other_users=0
show_thread_names=0
show_program_path=0
highlight_base_name=1
highlight_megabytes=1
highlight_threads=1
highlight_changes=0
highlight_change_delay_secs=5
find_comm_in_cmdline=1
strip_exe_from_cmdline=1
show_merged_command_line=0
header_margin=1
screen:Main=PID,PERCENT_CPU,PERCENT_MEM,PERCENT_SWAP,USER,NICE,M_RESIDENT,COMMAND
left_meters=AllCPUs2 Memory Swap
left_meter_modes=1 1 1
right_meters=Tasks LoadAverage Uptime
right_meter_modes=2 2 2
