# 白霜拼音 patch
# 语言模型二选一（由 .external.rime_gram 决定，见 .chezmoidata.toml）：
#   true  → 万象 LTS（~400MB，external 单独下载，见 .chezmoiexternals/rime.toml）
#   false → zh-moqi（白霜 zip 自带，~7MB，零下载）
# 模型参考 <https://github.com/amzxyz/RIME-LMDG> 与
# <https://www.mintimate.cc/zh/guide/languageModel.html>

{{- $wanxiang := dig "external" "rime_gram" false . }}

patch:
  translator/dictionary: rime_frost_custom # 挂载词库 rime_frost_custom
  pin_cand_filter:
    __include: pin_candidate:/list

  # 语言模型（octagram 插件；鼠须管 1.1.0+ 已内置）
  grammar:
{{- if $wanxiang }}
    language: wanxiang-lts-zh-hans
    collocation_max_length: 6
    collocation_min_length: 3
    collocation_penalty: -14
    non_collocation_penalty: -6
    weak_collocation_penalty: -100
    rear_penalty: -20
{{- else }}
    language: zh-moqi
    collocation_max_length: 5
    collocation_min_length: 2
    collocation_penalty: -14
    non_collocation_penalty: -4
{{- end }}
  translator/contextual_suggestions: true
  translator/max_homophones: 7
  translator/max_homographs: 7
