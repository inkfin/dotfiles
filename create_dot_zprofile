# vim: ft=zsh:
# ~/.zprofile is read for login shells, before ~/.zshrc.
# Put environment setup here, not interactive aliases or key bindings.

# Machine locale.
export LANG="en_SG.UTF-8"
export LC_ALL="en_SG.UTF-8"

# homebrew.zsh uses the shared PATH and helper functions. Keep the second
# source conditional: without helper.zsh, homebrew.zsh cannot do useful work.
if [[ -r "$HOME/.zshrc.d/helper.zsh" ]]; then
  source "$HOME/.zshrc.d/helper.zsh"
  [[ -r "$HOME/.zshrc.d/homebrew.zsh" ]] && source "$HOME/.zshrc.d/homebrew.zsh"
fi

if [[ -n "${SSH_CONNECTION:-}" ]]; then
  export GPG_TTY="$(tty 2>/dev/null)"
fi
