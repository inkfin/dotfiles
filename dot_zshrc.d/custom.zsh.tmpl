# -*- zsh -*-
# vi: ft=zsh

# ======================================
#  custom.zsh
# ======================================
#   user customizations & environment configs that don't require 3rd party plugins
# ======================================


# ==== Environment Variables ====
#
# PATH entries in this file are managed by chezmoi and tracked in git.
# Machine-specific PATH overrides belong in ~/.zshrc.d/local.zsh (create_).
# Helper functions (prepend_to_path, is_command, etc.) are defined in helper.zsh
# and sourced before this file.

## PATH — universal
## man
# export MANPATH="/usr/local/man:$MANPATH"
prepend_to_path MANPATH "/usr/local/man/"


# ==== User Commands ====

alias gcl="git clone"
alias gP="git push"
alias lg="lazygit"
alias lzd="lazydocker"
alias ee="exit"

# alias vim="nvim"
# alias nn="~/.local/neovim/bin/nvim"
# alias nvim="nn"
alias nvi="neovide"
alias v="nvim"
# nvim server / client
alias nvs='nvim --listen localhost:6789 --cmd "let safequit=v:true"'
alias nvc='nvim --server localhost:6789 --remote-ui'

sourcezsh() {
  if [[ -r "$HOME/.zshrc" ]]; then
    source "$HOME/.zshrc"
  else
    print -u2 "sourcezsh: $HOME/.zshrc not readable"
    return 1
  fi
}

restartzsh() {
  exec zsh
}

## lsd
if is_command lsd; then
  alias ls="lsd"
else
  alias ls="ls"
fi
alias l="ls"
alias ll="ls -l"
alias la="ls -al"
alias lt="ls --tree"

## chezmoi configs
alias cz="chezmoi"

alias zj="zellij"

## herdr
source_if_readable "$ZSHCONF_HOME/herdr.zsh"

alias vimfish="nvim ~/.local/share/chezmoi/dot_config/fish/config.fish"
alias vimzsh="nvim ~/.local/share/chezmoi/dot_zshrc.d/zshrc.tmpl"
alias vimrc="nvim ~/.local/share/chezmoi/dot_config/nvim.lazyvim/init.lua"
alias virc="vim ~/.local/share/chezmoi/dot_vim/vimrc"
alias custom_phrase="nvim ~/.local/share/chezmoi/dot_config/Rime/custom_phrase.txt"
alias vimtmpl="nvim ~/.local/share/chezmoi/template/"

## Rime
{{ if eq .chezmoi.os "darwin" }}
alias rimerc="nvim ~/.local/share/chezmoi/dot_config/Rime/squirrel.custom.yaml"
alias browse="~/.local/carbonyl-0.0.3/carbonyl"
alias netease='https_proxy=120.76.98.193:8080 nohup /Applications/NeteaseMusic.app/Contents/MacOS/NeteaseMusic >/dev/null 2>&1 &'
alias MACSecureInput="ioreg -l -d 1 -w 0 | grep SecureInput"

if is_command thefuck; then
  eval "$(thefuck --alias)"
fi

if is_command brew; then
  prepend_to_path DYLD_FALLBACK_LIBRARY_PATH "$(brew --prefix)/lib"
fi

# These macOS system paths can be injected into PATH by the OS.
remove_from_path PATH "/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin"
remove_from_path PATH "/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin"
remove_from_path PATH "/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin"
{{ end }}


# ==== User configurations ====

{{ if eq .chezmoi.os "linux" }}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
# wsl
export LC_CTYPE=C.UTF-8
{{   end }}
{{ end }}
