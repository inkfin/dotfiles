# vim: ft=zsh:
# Oh My Zsh configuration and self-contained installation.
#
# OMZ's built-in plugins live in the OMZ repository. Only the four custom
# plugins below need separate clones. This file deliberately does not run
# OMZ's installer, because that installer can edit ~/.zshrc.

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export DISABLE_AUTO_UPDATE="true"
plugins=(git tmux docker colored-man-pages vi-mode zsh-autosuggestions zsh-syntax-highlighting extract cp git-open safe-paste command-not-found zsh_codex rust)

# Run `omz-update` manually when you want to update OMZ and custom plugins.
# `--ff-only` refuses to overwrite or merge local changes.
omz-update() {
    local repo update_status=0
    for repo in "$ZSH" "$ZSH"/custom/plugins/*(N/); do
        [[ -d "$repo/.git" ]] || continue
        print "Updating ${repo:t}..."
        command git -C "$repo" pull --ff-only || update_status=1
    done
    return $update_status
}

_omz_clone() {
    local repo="$1" target="$2" marker="$3" temp
    if [[ -r "$target/$marker" ]]; then
        return 0
    fi
    if [[ -e "$target" ]]; then
        print -u2 "zsh: incomplete OMZ checkout: $target"
        return 1
    fi
    mkdir -p "${target:h}" || return 1
    temp="$(command mktemp -d "${target}.tmp.XXXXXX")" || return 1
    print "Installing ${target:t}..."
    command git clone --depth=1 "https://github.com/$repo" "$temp" || {
        command rm -rf -- "$temp"
        return 1
    }
    command mv -- "$temp" "$target" || {
        command rm -rf -- "$temp"
        return 1
    }
}

if ! is_command git; then
    print -u2 'zsh: git is required to install Oh My Zsh'
elif ! _omz_clone ohmyzsh/ohmyzsh "$ZSH" oh-my-zsh.sh; then
    print -u2 "zsh: Oh My Zsh is unavailable at $ZSH"
fi

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    _omz_clone zsh-users/zsh-autosuggestions "$ZSH/custom/plugins/zsh-autosuggestions" zsh-autosuggestions.zsh || print -u2 'zsh: failed to install zsh-autosuggestions'
    _omz_clone zsh-users/zsh-syntax-highlighting "$ZSH/custom/plugins/zsh-syntax-highlighting" zsh-syntax-highlighting.plugin.zsh || print -u2 'zsh: failed to install zsh-syntax-highlighting'
    _omz_clone paulirish/git-open "$ZSH/custom/plugins/git-open" git-open.plugin.zsh || print -u2 'zsh: failed to install git-open'
    _omz_clone tom-doerr/zsh_codex "$ZSH/custom/plugins/zsh_codex" zsh_codex.plugin.zsh || print -u2 'zsh: failed to install zsh_codex'
    if [[ -z "${__ZSH_OMZ_INIT:-}" ]]; then
        source_if_readable "$ZSH/oh-my-zsh.sh"
        __ZSH_OMZ_INIT=1
    fi

    # zsh_codex defines the widget but intentionally leaves the key choice to
    # the user. Keep the previous Ctrl-X binding from the old OMZ config.
    if (( $+widgets[create_completion] )); then
        bindkey '^X' create_completion
    fi
fi
